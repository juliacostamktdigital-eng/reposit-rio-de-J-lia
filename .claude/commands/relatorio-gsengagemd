## PASSO 2 — Cruzamento UTM (se CSV disponível)

Pergunte ao usuário se possui um CSV do RD Station ou Sheets Backup para cruzar UTMs.
Se sim, solicite o caminho do arquivo e execute o cruzamento:

```python
import csv, json
from collections import Counter

with open('/tmp/dponet_leads.json') as f:
    data = json.load(f)

all_emails  = set(data['all_emails'])
sql_emails  = set(data['sql_emails'])
mql_emails  = set(data['mql_emails'])

CSV_PATH = "/caminho/para/o/arquivo.csv"  # substituir pelo caminho real
UTM = ['utm_source','utm_campaign','utm_medium','utm_content','utm_adset',
       'utm source','utm campaign','utm medium']

best = {}
with open(CSV_PATH, encoding='utf-8') as f:
    for row in csv.DictReader(f):
        e = (row.get('email') or row.get('Email') or '').lower().strip()
        if e not in all_emails: continue
        score = sum(1 for c in UTM if row.get(c,'').strip())
        if score > best.get(e, {}).get('_score', -1):
            best[e] = {c: row.get(c,'').strip() for c in UTM if row.get(c,'').strip()}
            best[e]['_score'] = score

META_SRC   = {'fb','ig','facebook','facebook_mobile_feed','facebook_stories',
              'instagram','instagram_feed','instagram_stories','meta'}
GOOGLE_SRC = {'google','googleads','google_ads','sitelink'}

def canal(e):
    u = best.get(e, {})
    src  = u.get('utm_source', u.get('utm source','')).lower().strip()
    camp = u.get('utm_campaign', u.get('utm campaign','')).lower().strip()
    med  = u.get('utm_medium', u.get('utm medium','')).lower().strip()
    if src in META_SRC:   return 'Meta Ads'
    if src in GOOGLE_SRC: return 'Google Ads'
    if '[v4]' in camp or 'form-nativo' in camp or 'criativos' in camp: return 'Meta Ads'
    if med == 'cpc' and camp: return 'Google Ads'
    if src: return f'Outro ({src})'
    return 'Sem UTM / Orgânico'

L = Counter(canal(e) for e in all_emails)
S = Counter(canal(e) for e in sql_emails)
M = Counter(canal(e) for e in mql_emails)
all_c = sorted(set(list(L)+list(S)+list(M)))

print(f"\n{'='*60}")
print(f"RELATÓRIO CANAIS DE AQUISIÇÃO — {data['periodo']}")
print(f"{'='*60}")
print(f"{'Canal':<30} {'Leads':>7} {'MQLs':>7} {'SQLs':>7}")
print(f"{'-'*54}")
for c in sorted(all_c):
    print(f"{c:<30} {L.get(c,0):>7} {M.get(c,0):>7} {S.get(c,0):>7}")
print(f"{'-'*54}")
print(f"{'TOTAL':<30} {sum(L.values()):>7} {sum(M.values()):>7} {sum(S.values()):>7}")
print(f"{'='*60}")
```

